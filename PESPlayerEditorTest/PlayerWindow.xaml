<Window x:Class="PESPlayerEditorTest.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PESPlayerEditorTest"
        xmlns:logic="clr-namespace:JWE8Editor.Logic"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{Binding SelectedPlayerAssignment.Player.Name}" Height="800" Width="700" ResizeMode="NoResize">
    <Window.Resources>
        <logic:StatValueToBackgroundConverter x:Key="StatValueToBackgroundConverter"/>
        <logic:FaceTypeToIsEnabledConverter x:Key="FaceTypeToIsEnabledConverter"/>
        <logic:BootsTypeToIsEnabledConverter x:Key="BootsTypeToIsEnabledConverter"/>
        <local:FaceIdToPlayerNameConverter x:Key="FaceIdToPlayerNameConverter"/>
        <Style x:Key="StatTextBoxStyle" TargetType="TextBox">
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StatValueToBackgroundConverter}}"/>
            <EventSetter Event="PreviewTextInput" Handler="StatTextBox_PreviewTextInput"/>
            <EventSetter Event="LostFocus" Handler="StatTextBox_LostFocus"/>
            <EventSetter Event="PreviewKeyDown" Handler="StatTextBox_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="SelectionBrush" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#FF212121" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row for the menu -->
            <RowDefinition Height="*"/>
            <!-- Remaining space for the rest of the content -->
            <RowDefinition Height="Auto"/>
            <!-- Row for Apply / Cancel buttons, shared across all tabs -->
        </Grid.RowDefinitions>
        <TabControl Grid.Row="1" Background="#FF212121">
            <TabItem Header="Player">
                <Grid  Background="#FF212121" Width="1300" Height="740" VerticalAlignment="Center" Margin="4,0,0,0" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="683*"/>
                        <RowDefinition Height="13*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="19*"/>
                        <ColumnDefinition Width="241*"/>
                    </Grid.ColumnDefinitions>
                    <Separator HorizontalAlignment="Left" Margin="114,333,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                    <GroupBox x:Name="Player_Information" Header="General" Margin="14,15,1074,0" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" VerticalAlignment="Top" Height="386" Grid.ColumnSpan="2">
                        <Grid Height="383">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58.516"/>
                                <ColumnDefinition Width="8.444"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="265*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>

                            <Label Content="Player ID" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC"/>
                            <TextBox x:Name="playerIdTextBox" Grid.Column="3" TextWrapping="Wrap" VerticalAlignment="Center" IsEnabled="False" Height="21" Width="60" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="4,0,0,0"/>

                            <Label Grid.Row="1" Content="Name" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC"/>
                            <TextBox x:Name="nameTextBox" Grid.Column="2" TextWrapping="Wrap" Text="" Grid.ColumnSpan="2" Grid.Row="1" Height="21" Width="120" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"/>

                            <Label Grid.Row="2" Content="Commentary" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <ComboBox x:Name="commentaryComboBox" Grid.Row="2" Grid.Column="2" RenderTransformOrigin="1.113,-0.593" Height="21" Width="120" Grid.ColumnSpan="2" ItemsSource="{Binding CommentariesLoader.Commentaries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CommentaryName" SelectedValuePath="CommentaryIndex" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" IsEnabled="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>

                            <Label Grid.Row="3" Content="Country" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC"/>
                            <ComboBox x:Name="countryComboBox" Grid.Row="3" Grid.Column="2" RenderTransformOrigin="1.113,-0.593" Height="21" Width="120" Grid.ColumnSpan="2" ItemsSource="{Binding CountriesLoader.Countries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CountryName" SelectedValuePath="CountryId" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" IsEnabled="False"/>
                            
                            <Label Grid.Row="5" Content="Age" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC"/>
                            <ComboBox x:Name="ageComboBox" Grid.Row="5" Grid.Column="3" RenderTransformOrigin="1.113,-0.593" Height="21" ItemsSource="{Binding Ages}" SelectedItem="{Binding SelectedPlayer.Age, Mode=TwoWay}" ScrollViewer.CanContentScroll="False"
                    Width="58" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"/>
                            <Label Grid.Row="6" Content="Height (cm)" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="2"/>
                            <TextBox x:Name="heightTextBox" Grid.Row="6" Grid.Column="3" TextWrapping="Wrap" Margin="4,0,0,0" Height="21" Width="58" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Height, Mode=TwoWay}"/>

                            <Label Grid.Row="7" Content="Weight (kg)" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="2"/>
                            <TextBox x:Name="weightTextBox" Grid.Row="7" Grid.Column="3" TextWrapping="Wrap" RenderTransformOrigin="0.438,2.093" Margin="4,0,0,0" Height="21" Width="58" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Weight, Mode=TwoWay}"/>

                            <Label Grid.Row="8" Content="Foot" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <ComboBox x:Name="footComboBox" Grid.Row="8" Grid.Column="2" Height="21" Width="58" Margin="5,0,60,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding FeetValues}" SelectedItem="{Binding SelectedPlayer.DominantFoot, Mode=TwoWay}"/>

                            <Label Grid.Row="9" Content="Side" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <CheckBox x:Name="sideCheckBox" Grid.Row="9" Grid.Column="2" Height="21" Width="16" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding SelectedPlayer.Side, Mode=TwoWay}"/>
                            <Label Grid.Row="9" Grid.Column="3" Content="Center" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC"/>
                            <CheckBox x:Name="centerCheckBox" Grid.Row="9" Grid.Column="3" Height="21" Width="16" Margin="48,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding SelectedPlayer.Center, Mode=TwoWay}"/>

                            <Label Grid.Row="11" Content="Consistency" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <TextBox x:Name="consistencyTextBox" Grid.Row="11" Grid.Column="2" Height="21" Width="58" Margin="5,0,60,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Consistency, Mode=TwoWay}"/>

                            <Label Grid.Row="12" Content="Condition" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <TextBox x:Name="conditionTextBox" Grid.Row="12" Grid.Column="2" Height="21" Width="58" Margin="5,0,60,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Condition, Mode=TwoWay}"/>

                            <Label Grid.Row="10" Content="Weak Foot" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <TextBox x:Name="WeakFootAccTextBox" Grid.Row="10" Grid.Column="2" Height="21" Margin="5,0,61,0" Grid.ColumnSpan="2" Width="58" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.WeakFootAccuracy, Mode=TwoWay}"/>
                            <TextBox x:Name="WeakFootUseTextBox" Grid.Row="10" Grid.Column="3" VerticalAlignment="Center" Height="21" Margin="66,0,6,0" Width="58" Text="{Binding SelectedPlayer.WeakFootFrequency, Mode=TwoWay}"/>

                            <Label Grid.Row="13" Content="Injury Res." HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="3"/>
                            <ComboBox x:Name="injuryComboBox" Grid.Row="13" Grid.Column="2" Height="21" Width="58" Margin="5,0,60,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding InjuryValues}" SelectedItem="{Binding SelectedPlayer.Injury, Mode=TwoWay}"/>


                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="Position" Header="Position" Margin="14,406,1074,0" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" VerticalAlignment="Top" Height="289" Grid.ColumnSpan="2" Grid.RowSpan="2">
                        <Grid Height="257">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="17*"/>
                                <ColumnDefinition Width="145*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="21"/>
                            </Grid.RowDefinitions>

                            <Label Content="Reg. Position" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="5" Width="68"/>
                            <ComboBox x:Name="positionComboBox" ItemsSource="{Binding Positions}" SelectedValue="{Binding SelectedPlayer.Position}" DisplayMemberPath="PositionName" SelectedValuePath="PositionId" ScrollViewer.CanContentScroll="False"
                    Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="21" Margin="25,0,0,0"/>

                            <CheckBox x:Name="gkCheckBox"  VerticalAlignment="Center" Grid.Row="1" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayGK, Mode=TwoWay}"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="Goal Keeper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="liCheckBox"  VerticalAlignment="Center" Grid.Row="2" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayCBT, Mode=TwoWay}"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="Libero" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="swCheckBox"  VerticalAlignment="Center" Grid.Row="3" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayCBW, Mode=TwoWay}"/>
                            <Label Grid.Row="3" Grid.Column="2" Content="Sweeper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="cbCheckBox"  VerticalAlignment="Center" Grid.Row="4" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayCBW, Mode=TwoWay}"/>
                            <Label Grid.Row="4" Grid.Column="2" Content="Central Back Stopper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="sbCheckBox"  VerticalAlignment="Center" Grid.Row="5" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlaySB, Mode=TwoWay}"/>
                            <Label Grid.Row="5" Grid.Column="2" Content="Side Back" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="dmfCheckBox"  VerticalAlignment="Center" Grid.Row="6" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayDMF, Mode=TwoWay}"/>
                            <Label Grid.Row="6" Grid.Column="2" Content="Defensive Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="cmfCheckBox"  VerticalAlignment="Center" Grid.Row="7" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayCMF, Mode=TwoWay}"/>
                            <Label Grid.Row="7" Grid.Column="2" Content="Centre Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="smfCheckBox"  VerticalAlignment="Center" Grid.Row="8" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlaySMF, Mode=TwoWay}"/>
                            <Label Grid.Row="8" Grid.Column="2" Content="Side Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="amfCheckBox"  VerticalAlignment="Center" Grid.Row="9" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayAMF, Mode=TwoWay}"/>
                            <Label Grid.Row="9" Grid.Column="2" Content="Offensive Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="cfCheckBox"  VerticalAlignment="Center" Grid.Row="10" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayCF, Mode=TwoWay}"/>
                            <Label Grid.Row="10" Grid.Column="2" Content="Centre Forward" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                            <CheckBox x:Name="wgCheckBox"  VerticalAlignment="Center" Grid.Row="11" Height="16" Margin="3,0,3,0" Width="16" IsChecked="{Binding SelectedPlayer.CanPlayWF, Mode=TwoWay}"/>
                            <Label Grid.Row="11" Grid.Column="2" Content="Wing Forward" FontSize="10" Foreground="#FFECECEC" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="1,0,0,0"/>

                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="Player_Abilities" Header="Abilities" Margin="136,15,869,0" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" Width="200" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" VerticalAlignment="Top" Height="680" Grid.Column="1" Grid.RowSpan="2">
                        <Grid Height="649">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86.516"/>
                                <ColumnDefinition Width="8.444"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="72*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
