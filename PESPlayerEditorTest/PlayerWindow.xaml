                            <TextBox x:Name="statShortPassSpeedTextBox" Style="{StaticResource StatTextBoxStyle}" Grid.Row="11" Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center" Grid.ColumnSpan="4" Margin="0,0,31,0" Height="20" Text="{Binding SelectedPlayer.ShortPassSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

