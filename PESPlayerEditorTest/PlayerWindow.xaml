<Window x:Class="PESPlayerEditorTest.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PESPlayerEditorTest"
        xmlns:logic="clr-namespace:JWE8Editor.Logic"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{Binding SelectedPlayerAssignment.Player.Name}" Height="800" Width="1200" ResizeMode="NoResize">
    <Window.Resources>
        <logic:StatValueToBackgroundConverter x:Key="StatValueToBackgroundConverter"/>
        <logic:FaceTypeToIsEnabledConverter x:Key="FaceTypeToIsEnabledConverter"/>
        <logic:BootsTypeToIsEnabledConverter x:Key="BootsTypeToIsEnabledConverter"/>
        <local:FaceIdToPlayerNameConverter x:Key="FaceIdToPlayerNameConverter"/>
        <Style x:Key="StatTextBoxStyle" TargetType="TextBox">
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StatValueToBackgroundConverter}}"/>
            <EventSetter Event="PreviewTextInput" Handler="StatTextBox_PreviewTextInput"/>
            <EventSetter Event="LostFocus" Handler="StatTextBox_LostFocus"/>
            <EventSetter Event="PreviewKeyDown" Handler="StatTextBox_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="SelectionBrush" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatArrowButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="#FFECECEC"/>
            <Setter Property="BorderBrush" Value="#FF0A0A0A"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Delay" Value="400"/>
            <Setter Property="Interval" Value="75"/>
        </Style>
    </Window.Resources>
    <Grid Background="#FF212121">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Width="0"/>
        <Grid  Background="#FF212121" Height="780" VerticalAlignment="Top" HorizontalAlignment="Left" Width="1200" Margin="5,2,5,2" Grid.Row="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="389"/>
                <RowDefinition Height="378"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="195"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="225"/>
            </Grid.ColumnDefinitions>
            <Separator Margin="99,333,81,0" VerticalAlignment="Top" Grid.Column="1" Height="1"/>
            <GroupBox x:Name="Player_Information" Header="General" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" VerticalAlignment="Top" Height="379" Margin="0,0,1,0">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="4"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <Label Content="Player ID" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="49"/>
                    <TextBox x:Name="playerIdTextBox" Grid.Column="1" TextWrapping="Wrap" IsEnabled="False" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,2,2,2" Grid.ColumnSpan="2"/>

                    <Label Grid.Row="1" Content="Name" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="36"/>
                    <TextBox x:Name="nameTextBox" Grid.Column="1" TextWrapping="Wrap" Text="" Grid.Row="1" Height="21" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" MaxLength="15" PreviewTextInput="NameTextBox_PreviewTextInput" DataObject.Pasting="NameTextBox_Pasting" Grid.ColumnSpan="2" Margin="0,0,2,0"/>

                    <Label Grid.Row="2" Content="Shirt Name" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="59"/>
                    <TextBox x:Name="shirtNameTextBox" Grid.Column="1" TextWrapping="Wrap" Text="" Grid.Row="2" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" MaxLength="15" PreviewTextInput="ShirtNameTextBox_PreviewTextInput" DataObject.Pasting="ShirtNameTextBox_Pasting" Grid.ColumnSpan="2" Margin="0,2,2,2"/>

                    <Label Grid.Row="3" Content="Commentary" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="67"/>
                    <ComboBox x:Name="commentaryComboBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CommentariesLoader.Commentaries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CommentaryName" SelectedValuePath="CommentaryIndex" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" Grid.ColumnSpan="2" Margin="0,2,2,2">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <Label Grid.Row="4" Content="Country" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="45"/>
                    <ComboBox x:Name="countryComboBox" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CountriesLoader.Countries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CountryName" SelectedValuePath="CountryId" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2" Margin="0,2,2,2"/>

                    <Label Grid.Row="5" Content="Age" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="28"/>
                    <ComboBox x:Name="ageComboBox" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Ages}" SelectedItem="{Binding SelectedPlayer.Age, Mode=TwoWay}" ScrollViewer.CanContentScroll="False"
                        Width="54" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,2,0,2"/>
                    <Label Grid.Row="6" Content="Height (cm)" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="62"/>
                    <TextBox x:Name="heightTextBox" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Width="54" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Height, Mode=TwoWay}" Margin="0,2,0,2"/>

                    <Label Grid.Row="7" Content="Weight (kg)" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="61"/>
                    <TextBox x:Name="weightTextBox" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Weight, Mode=TwoWay}" Margin="0,2,4,2"/>

                    <Label Grid.Row="8" Content="Foot" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="30"/>
                    <ComboBox x:Name="footComboBox" Grid.Row="8" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding FeetValues}" SelectedItem="{Binding SelectedPlayer.DominantFoot, Mode=TwoWay}" Margin="0,2,4,2"/>

                    <Label Grid.Row="9" Content="Consistency" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="62"/>
                    <TextBox x:Name="consistencyTextBox" Grid.Row="9" Grid.Column="1" Height="21" Width="54" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Consistency, Mode=TwoWay}"/>

                    <Label Grid.Row="10" Content="Condition" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="53"/>
                    <TextBox x:Name="conditionTextBox" Grid.Row="10" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Condition, Mode=TwoWay}" Margin="0,2,4,2"/>
                    <Label Grid.Row="11" Content="Weak Foot" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="57"/>
                    <TextBox x:Name="WeakFootAccTextBox" Grid.Row="11" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.WeakFootAccuracy, Mode=TwoWay}" Margin="0,2,4,2"/>
                    <TextBox x:Name="WeakFootUseTextBox" Grid.Row="11" Grid.Column="2" Text="{Binding SelectedPlayer.WeakFootFrequency, Mode=TwoWay}" Margin="1,2,2,2"/>

                    <Label Grid.Row="12" Content="Injury Res." HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="23" Width="55"/>
                    <ComboBox x:Name="injuryComboBox" Grid.Row="12" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding InjuryValues}" SelectedItem="{Binding SelectedPlayer.Injury, Mode=TwoWay}" Margin="0,2,4,2"/>

                </Grid>
            </GroupBox>
            <GroupBox x:Name="Position" Header="Position" Margin="0,379,1,9" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" Grid.RowSpan="2">
                <Grid Height="257" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="149*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                    </Grid.RowDefinitions>

                    <Label Content="Position" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Width="42" Height="23" Grid.ColumnSpan="3" Margin="2,0,0,0"/>
                    <ComboBox x:Name="positionComboBox" ItemsSource="{Binding Positions}" SelectedValue="{Binding SelectedPlayer.Position}" DisplayMemberPath="PositionName" SelectedValuePath="PositionId" ScrollViewer.CanContentScroll="False"
                        Grid.Column="3" HorizontalAlignment="Left" Width="146" Margin="1,2,0,2"/>

                    <CheckBox x:Name="gkCheckBox"  VerticalAlignment="Center" Grid.Row="1" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayGK, Mode=TwoWay}"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="Goal Keeper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="64" Margin="1,0,0,0"/>

                    <CheckBox x:Name="liCheckBox"  VerticalAlignment="Center" Grid.Row="2" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayCBT, Mode=TwoWay}"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="Libero" HorizontalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Width="38"/>

                    <CheckBox x:Name="swCheckBox"  VerticalAlignment="Center" Grid.Row="3" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayCBW, Mode=TwoWay}"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="Sweeper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="47" Margin="1,0,0,0"/>

                    <CheckBox x:Name="cbCheckBox"  VerticalAlignment="Center" Grid.Row="4" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayCBW, Mode=TwoWay}"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="Central Back Stopper" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="102" Margin="1,0,0,0"/>

                    <CheckBox x:Name="sbCheckBox"  VerticalAlignment="Center" Grid.Row="5" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlaySB, Mode=TwoWay}"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="Side Back" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="52" Margin="1,0,0,0"/>

                    <CheckBox x:Name="dmfCheckBox"  VerticalAlignment="Center" Grid.Row="6" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayDMF, Mode=TwoWay}"/>
                    <Label Grid.Row="6" Grid.Column="2" Content="Defensive Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="101" Margin="1,0,0,0"/>

                    <CheckBox x:Name="cmfCheckBox"  VerticalAlignment="Center" Grid.Row="7" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayCMF, Mode=TwoWay}"/>
                    <Label Grid.Row="7" Grid.Column="2" Content="Centre Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="87" Margin="1,0,0,0"/>

                    <CheckBox x:Name="smfCheckBox"  VerticalAlignment="Center" Grid.Row="8" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlaySMF, Mode=TwoWay}"/>
                    <Label Grid.Row="8" Grid.Column="2" Content="Side Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="77" Margin="1,0,0,0"/>

                    <CheckBox x:Name="amfCheckBox"  VerticalAlignment="Center" Grid.Row="9" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayAMF, Mode=TwoWay}"/>
                    <Label Grid.Row="9" Grid.Column="2" Content="Offensive Midfielder" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="99" Margin="1,0,0,0"/>

                    <CheckBox x:Name="cfCheckBox"  VerticalAlignment="Center" Grid.Row="10" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayCF, Mode=TwoWay}"/>
                    <Label Grid.Row="10" Grid.Column="2" Content="Centre Forward" HorizontalAlignment="Left" FontSize="10" Foreground="#FFECECEC" Height="24" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="78" Margin="1,0,0,0"/>

                    <CheckBox x:Name="wgCheckBox"  VerticalAlignment="Center" Grid.Row="11" Height="16" Margin="3,0,3,0" IsChecked="{Binding SelectedPlayer.CanPlayWF, Mode=TwoWay}"/>
                    <Label Grid.Row="11" Grid.Column="2" Content="Wing Forward" FontSize="10" Foreground="#FFECECEC" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="72" Margin="1,0,0,0"/>

                </Grid>
            </GroupBox>
            <GroupBox x:Name="Player_Abilities" Header="Abilities" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" Grid.RowSpan="2" Margin="1,0,4,9" Grid.Column="1">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="94"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Label Content="Offense" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="44"/>
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statOffenseTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Attack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="1" Content="Defense" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="46"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statDefenseTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Defense, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="2" Content="Body Balance" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="69"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statBodyBalanceTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Balance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="3" Content="Stamina" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="45"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statStaminaTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Stamina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="4" Content="Top Speed" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="56"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statTopSpeedTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.TopSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="5" Content="Acceleration" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="64"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statAccelerationTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Acceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="6" Content="Response" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="52"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statResponseTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Response, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="7" Content="Agility" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="38"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statAgilityTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Agility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="8" Content="Dribble Acc." HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="63"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statDribbleAccuracyTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.DribbleAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="9" Content="Dribble Speed" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="73"/>
                    <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statDribbleSpeedTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.DribbleSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="10" Content="Short Pass Acc." HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Margin="1,0,0,0" Height="24" Width="76"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statShortPassAccTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShortPassAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

                    <Label Grid.Row="11" Content="Short Pass Speed" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="86"/>
                    <StackPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="-1" Click="StatArrowButton_Click" Content="◀"/>
                        <TextBox x:Name="statShortPassSpeedTextBox" Style="{StaticResource StatTextBoxStyle}" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShortPassSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <RepeatButton Style="{StaticResource StatArrowButtonStyle}" Tag="1" Click="StatArrowButton_Click" Content="▶"/>
                    </StackPanel>

