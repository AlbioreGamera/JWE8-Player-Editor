                        <Label Grid.Row="12" Content="Boots Type" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{Binding BootsTypeValues}" SelectedItem="{Binding SelectedPlayer.BootsType, Mode=TwoWay}" Height="21" Grid.ColumnSpan="3" Margin="0,2,0,1"/>
                        <Label Grid.Row="13" Content="Boots Base Colour" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="13" Grid.Column="1" ItemsSource="{Binding BootsColorValues}" SelectedItem="{Binding SelectedPlayer.BootsBaseColor, Mode=TwoWay}" Height="21"
                            IsEnabled="{Binding SelectedPlayer.BootsType, Converter={StaticResource BootsTypeToIsEnabledConverter}}" Grid.ColumnSpan="3" Margin="0,2,0,1"/>

                        <Label Grid.Row="14" Content="Boots Line Colour 1" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="14" Grid.Column="1" ItemsSource="{Binding BootsColorValues}" SelectedItem="{Binding SelectedPlayer.BootsLineColor1, Mode=TwoWay}" Height="21"
                            IsEnabled="{Binding SelectedPlayer.BootsType, Converter={StaticResource BootsTypeToIsEnabledConverter}}" Grid.ColumnSpan="3" Margin="0,2,0,1"/>

                        <Label Grid.Row="15" Content="Boots Line Colour 2" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="15" Grid.Column="1" ItemsSource="{Binding BootsColorValues}" SelectedItem="{Binding SelectedPlayer.BootsLineColor2, Mode=TwoWay}" Height="21"
                            IsEnabled="{Binding SelectedPlayer.BootsType, Converter={StaticResource BootsTypeToIsEnabledConverter}}" Grid.ColumnSpan="3" Margin="0,2,0,1"/>

                        <Label Grid.Row="16" Content="Boots Tongue Colour" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="16" Grid.Column="1" ItemsSource="{Binding BootsColorValues}" SelectedItem="{Binding SelectedPlayer.BootsTongueColor, Mode=TwoWay}" Height="21"
                            IsEnabled="{Binding SelectedPlayer.BootsType, Converter={StaticResource BootsTypeToIsEnabledConverter}}" Grid.ColumnSpan="3" Margin="0,2,0,1"/>

                        <Label Grid.Row="17" Content="Boots Studs Colour" FontSize="10" Foreground="#FFECECEC"/>
                        <ComboBox Grid.Row="17" Grid.Column="1" ItemsSource="{Binding BootsColorValues}" SelectedItem="{Binding SelectedPlayer.BootsStudsColour, Mode=TwoWay}" Height="21"
                            IsEnabled="{Binding SelectedPlayer.BootsType, Converter={StaticResource BootsTypeToIsEnabledConverter}}" Grid.ColumnSpan="3" Margin="0,2,0,1"/>

                    </Grid>
                </ScrollViewer>
            </GroupBox>
            <Grid Grid.Column="5" Grid.Row="3" ClipToBounds="True" Margin="0,0,46,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <Button x:Name="applyButton" Content="💾 Accept" Click="SavePlayer" Grid.Row="5"/>
                <Button x:Name="cancelButton" Content="❌Cancel" Click="ClosePlayerWindow" Grid.Row="3"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
