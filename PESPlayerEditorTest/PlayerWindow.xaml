<Window x:Class="PESPlayerEditorTest.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PESPlayerEditorTest"
        xmlns:logic="clr-namespace:JWE8Editor.Logic"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Title="{Binding SelectedPlayerAssignment.Player.Name}" Height="800" Width="1150" ResizeMode="NoResize">
    <Window.Resources>
        <logic:StatValueToBackgroundConverter x:Key="StatValueToBackgroundConverter"/>
        <logic:EightScaleValueToBackgroundConverter x:Key="EightScaleValueToBackgroundConverter"/>
        <logic:FaceTypeToIsEnabledConverter x:Key="FaceTypeToIsEnabledConverter"/>
        <logic:BootsTypeToIsEnabledConverter x:Key="BootsTypeToIsEnabledConverter"/>
        <local:FaceIdToPlayerNameConverter x:Key="FaceIdToPlayerNameConverter"/>
        
        <Style x:Key="StatTextBoxStyle" TargetType="TextBox">
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StatValueToBackgroundConverter}}"/>
            <EventSetter Event="PreviewTextInput" Handler="StatTextBox_PreviewTextInput"/>
            <EventSetter Event="LostFocus" Handler="StatTextBox_LostFocus"/>
            <EventSetter Event="PreviewKeyDown" Handler="StatTextBox_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="SelectionBrush" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RangeTextBoxStyle" TargetType="TextBox">
            <EventSetter Event="PreviewTextInput" Handler="StatTextBox_PreviewTextInput"/>
            <EventSetter Event="TextChanged" Handler="RangeTextBox_TextChanged"/>
            <EventSetter Event="LostFocus" Handler="RangeTextBox_LostFocus"/>
            <EventSetter Event="PreviewKeyDown" Handler="RangeTextBox_PreviewKeyDown"/>
        </Style>
        <Style x:Key="EightScaleRangeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RangeTextBoxStyle}">
            <Setter Property="Background" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EightScaleValueToBackgroundConverter}}"/>
        </Style>
        <Style x:Key="StatArrowButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF3A3A3A"/>
            <Setter Property="Foreground" Value="#FFECECEC"/>
            <Setter Property="BorderBrush" Value="#FF0A0A0A"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Delay" Value="400"/>
            <Setter Property="Interval" Value="75"/>
        </Style>
        <Style x:Key="CheckBoxLabelStyle" TargetType="Label">
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="CheckBoxLabel_MouseLeftButtonUp"/>
        </Style>
    </Window.Resources>
    <Grid Background="#FF212121">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left"/>
        <Grid  Background="#FF212121" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="252"/>
                <RowDefinition Height="143"/>
                <RowDefinition Height="202"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="194"/>
                <ColumnDefinition Width="156"/>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="207"/>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="267"/>
            </Grid.ColumnDefinitions>
            <Separator Margin="99,153,57,0" VerticalAlignment="Top" Grid.Column="1" Height="1" Grid.Row="1"/>
            <GroupBox x:Name="Player_Information" Header="General" Foreground="#FF9A9A9A" ClipToBounds="True" Grid.RowSpan="2" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Player ID" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC" Margin="0,1,0,1"/>
                    <TextBox x:Name="playerIdTextBox" Grid.Column="1" TextWrapping="Wrap" IsEnabled="False" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,2,2,2" Grid.ColumnSpan="2"/>

                    <Label Grid.Row="1" Content="Name" FontSize="10" HorizontalAlignment="Right" Foreground="#FFECECEC" Margin="0,1,0,1"/>
                    <TextBox x:Name="nameTextBox" Grid.Column="1" TextWrapping="Wrap" Text="" Grid.Row="1" Height="21" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" MaxLength="15" PreviewTextInput="NameTextBox_PreviewTextInput" DataObject.Pasting="NameTextBox_Pasting" Grid.ColumnSpan="2" Margin="0,0,2,0"/>

                    <Label Grid.Row="2" Content="Shirt Name" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC" Margin="0,1,0,1"/>
                    <TextBox x:Name="shirtNameTextBox" Grid.Column="1" TextWrapping="Wrap" Text="" Grid.Row="2" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" MaxLength="15" PreviewTextInput="ShirtNameTextBox_PreviewTextInput" DataObject.Pasting="ShirtNameTextBox_Pasting" Grid.ColumnSpan="2" Margin="0,2,2,2"/>

                    <Label Grid.Row="3" Content="Commentary" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox x:Name="commentaryComboBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CommentariesLoader.Commentaries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CommentaryName" SelectedValuePath="CommentaryIndex" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True" Grid.ColumnSpan="2" Margin="0,2,2,2">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <Label Grid.Row="4" Content="Country" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC" Margin="0,1,0,1"/>
                    <ComboBox x:Name="countryComboBox" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CountriesLoader.Countries, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" DisplayMemberPath="CountryName" SelectedValuePath="CountryId" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2" Margin="0,2,2,2"/>

                    <Label Grid.Row="5" Content="Age" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox x:Name="ageComboBox" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Ages}" SelectedItem="{Binding SelectedPlayer.Age, Mode=TwoWay}" ScrollViewer.CanContentScroll="False"
                        Width="54" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  Margin="0,2,0,2"/>

                    <Label Grid.Row="6" Content="Height (cm)" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox x:Name="heightTextBox" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Width="54" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Height, Mode=TwoWay}" Tag="148:205" MaxLength="3" Style="{StaticResource RangeTextBoxStyle}" Margin="0,2,0,2"/>

                    <Label Grid.Row="7" Content="Weight (kg)" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox x:Name="weightTextBox" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Weight, Mode=TwoWay}" Tag="41:124" MaxLength="3" Style="{StaticResource RangeTextBoxStyle}" Margin="0,2,4,2"/>
                    
                    <Label Grid.Row="8" Content="Foot" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox x:Name="footComboBox" Grid.Row="8" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding FeetValues}" SelectedItem="{Binding SelectedPlayer.DominantFoot, Mode=TwoWay}" Margin="0,2,4,2"/>
                    
                    <Label Grid.Row="9" Content="Consistency" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox x:Name="consistencyTextBox" Grid.Row="9" Grid.Column="1" Height="21" Width="54" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Consistency, Mode=TwoWay}" Tag="1:8" MaxLength="1" Style="{StaticResource EightScaleRangeTextBoxStyle}"/>

                    <Label Grid.Row="10" Content="Condition" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox x:Name="conditionTextBox" Grid.Row="10" Grid.Column="1" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.Condition, Mode=TwoWay}" Tag="1:8" MaxLength="1" Style="{StaticResource EightScaleRangeTextBoxStyle}" Margin="0,2,4,2"/>

                    <Label Grid.Row="11" Content="Weak Foot" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox x:Name="WeakFootAccTextBox" Grid.Row="11" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Text="{Binding SelectedPlayer.WeakFootAccuracy, Mode=TwoWay}" Tag="1:8" MaxLength="1" Style="{StaticResource EightScaleRangeTextBoxStyle}" Margin="0,2,4,2"/>
                    <TextBox x:Name="WeakFootUseTextBox" Grid.Row="11" Grid.Column="2" Text="{Binding SelectedPlayer.WeakFootFrequency, Mode=TwoWay}" Tag="1:8" MaxLength="1" Style="{StaticResource EightScaleRangeTextBoxStyle}" Margin="1,2,2,2"/>

                    <Label Grid.Row="12" Content="Injury Res." HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox x:Name="injuryComboBox" Grid.Row="12" Grid.Column="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" ItemsSource="{Binding InjuryValues}" SelectedItem="{Binding SelectedPlayer.Injury, Mode=TwoWay}" Margin="0,2,4,2"/>

                </Grid>
            </GroupBox>
            <GroupBox x:Name="Position" Header="Position" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" Grid.RowSpan="1" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" Grid.Row="2">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                    </Grid.RowDefinitions>

                    <Label Content="Registered Position" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Grid.ColumnSpan="4" Margin="0,0,21,0"/>
                    <ComboBox x:Name="positionComboBox" ItemsSource="{Binding Positions}" SelectedValue="{Binding SelectedPlayer.Position}" DisplayMemberPath="PositionName" SelectedValuePath="PositionId" ScrollViewer.CanContentScroll="False"
                 Grid.Column="4" Margin="1,2,6,2" Grid.ColumnSpan="2" SelectionChanged="PositionComboBox_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="ToolTip" Value="{Binding PositionTooltip}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <CheckBox x:Name="gkCheckBox"  VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"  IsChecked="{Binding SelectedPlayer.CanPlayGK, Mode=TwoWay}" Margin="6,0,0,0"/>
                    <Label Grid.Row="1" Grid.Column="1" Content="GK" FontSize="10" VerticalAlignment="Center" Foreground="#FFECECEC" Grid.ColumnSpan="1" Margin="0,0,13,0" Tag="gkCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="swCheckBox"  VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" IsChecked="{Binding SelectedPlayer.CanPlayCBW, Mode=TwoWay}" Margin="6,0,0,0"/>
                    <Label Grid.Row="2" Grid.Column="1" Content="SWP" FontSize="10" VerticalAlignment="Center" Foreground="#FFECECEC" Margin="0,0,6,0" Tag="swCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="cbCheckBox"  VerticalAlignment="Center" Grid.Row="2" Grid.Column="2" IsChecked="{Binding SelectedPlayer.CanPlayCBT, Mode=TwoWay}" Margin="6,0,0,0"/>
                    <Label Grid.Row="2" Grid.Column="3" Content="CB"  FontSize="10" VerticalAlignment="Center" Foreground="#FFECECEC" Margin="0,0,14,0" Tag="cbCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>
                    <CheckBox x:Name="sbCheckBox"  VerticalAlignment="Center" Grid.Row="2" Grid.Column="4" IsChecked="{Binding SelectedPlayer.CanPlaySB, Mode=TwoWay}" Margin="6,0,0,0"/>
                    <Label Grid.Row="2" Grid.Column="5" Content="SB" FontSize="10" VerticalAlignment="Center" Foreground="#FFECECEC" Margin="0,0,15,0" Tag="sbCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="dmfCheckBox"  VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" IsChecked="{Binding SelectedPlayer.CanPlayDMF, Mode=TwoWay}" Margin="6,0,0,0"/>
                    <Label Grid.Row="3" Grid.Column="1" Content="DMF" FontSize="10" VerticalAlignment="Center" Foreground="#FFECECEC" Margin="0,0,5,0" Tag="dmfCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="cmfCheckBox"  VerticalAlignment="Center" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" IsChecked="{Binding SelectedPlayer.CanPlayCMF, Mode=TwoWay}"/>
                    <Label Grid.Row="3" Grid.Column="3" Content="CMF" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFECECEC" Tag="cmfCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="smfCheckBox" VerticalAlignment="Center" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Right" IsChecked="{Binding SelectedPlayer.CanPlaySMF, Mode=TwoWay}"/>
                    <Label Grid.Row="3" Grid.Column="5" Content="SMF" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFECECEC" Tag="smfCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="amfCheckBox"  VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" IsChecked="{Binding SelectedPlayer.CanPlayAMF, Mode=TwoWay}"/>
                    <Label Grid.Row="4" Grid.Column="1" Content="OMF" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFECECEC" Tag="amfCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="cfCheckBox"  VerticalAlignment="Center" Grid.Row="4" Grid.Column="4" HorizontalAlignment="Right" IsChecked="{Binding SelectedPlayer.CanPlayCF, Mode=TwoWay}"/>
                    <Label Grid.Row="4" Grid.Column="5" Content="CF" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFECECEC" Tag="cfCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>

                    <CheckBox x:Name="wgCheckBox"  VerticalAlignment="Center" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" IsChecked="{Binding SelectedPlayer.CanPlayWF, Mode=TwoWay}"/>
                    <Label Grid.Row="4" Grid.Column="3" Content="WF" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFECECEC" Tag="wgCheckBox" Style="{StaticResource CheckBoxLabelStyle}"/>                </Grid>
            </GroupBox>
            <GroupBox x:Name="Motion" Header="Motion" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" Grid.Row="3" Grid.RowSpan="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Free Kick Type" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FreeKickTypeValues}" SelectedItem="{Binding SelectedPlayer.FreeKickType, Mode=TwoWay}" Height="21" Width="90" HorizontalAlignment="Left" Margin="0,2,0,1"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Penalty Kick" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PenaltyKickTypeValues}" SelectedItem="{Binding SelectedPlayer.PenaltyKickType, Mode=TwoWay}" Height="21" Width="90" HorizontalAlignment="Left" Margin="0,2,0,1"/>

                    <Label Grid.Row="2" Content="Goal Celeb. 1" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlayer.GoalCelebration1, Mode=TwoWay}" Tag="0:37" MaxLength="2" Style="{StaticResource RangeTextBoxStyle}" Margin="0,2,58,2"/>

                    <Label Grid.Row="3" Content="Goal Celeb. 2" HorizontalAlignment="Right" FontSize="10" Foreground="#FFECECEC"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPlayer.GoalCelebration2, Mode=TwoWay}" Tag="0:37" MaxLength="2" Style="{StaticResource RangeTextBoxStyle}" Margin="0,2,58,2"/>
                </Grid>
            </GroupBox>
            <GroupBox x:Name="Player_Abilities" Header="Abilities" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" Grid.RowSpan="4" Grid.Column="1">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Label Content="Offense" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statOffenseTextBox" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Attack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="1" Content="Defense" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statDefenseTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Defense, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="2" Content="Body Balance" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statBodyBalanceTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Balance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="3" Content="Stamina" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="45"/>
                    <TextBox x:Name="statStaminaTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Stamina, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="4" Content="Top Speed" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statTopSpeedTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.TopSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="5" Content="Acceleration" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statAccelerationTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Acceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="6" Content="Response" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24" Width="52"/>
                    <TextBox x:Name="statResponseTextBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Response, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="7" Content="Agility" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statAgilityTextBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.Agility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="8" Content="Dribble Acc." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statDribbleAccuracyTextBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.DribbleAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="9" Content="Dribble Speed" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statDribbleSpeedTextBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.DribbleSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="10" Content="Short Pass Acc." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statShortPassAccTextBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShortPassAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="11" Content="Short Pass Speed" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statShortPassSpeedTextBox" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShortPassSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="12" Content="Long Pass Acc." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statLongPassAccTextBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.LongPassAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="13" Content="Long Pass Speed" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statLongPassSpeedTextBox" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.LongPassSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="14" Content="Shoot Accuracy" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statShootAccTextBox" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShotAccuracy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="15" Content="Shot Power" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#FFECECEC" Height="24"/>
                    <TextBox x:Name="statShootPowerTextBox" Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatTextBoxStyle}" HorizontalAlignment="Left" Margin="2,0,2,0" Text="{Binding SelectedPlayer.ShotPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

