                    <GroupBox x:Name="BodyMeasurements" Header="Body Measurements" Margin="5,15,0,0" Foreground="#FF9A9A9A" ClipToBounds="True" BorderThickness="0.25,0.25,0.25,0.25" BorderBrush="#FF0A0A0A" Padding="1,5,1,5" VerticalAlignment="Top" Height="330" Width="340" HorizontalAlignment="Left" Grid.Column="1">
