<Window x:Class="PESPlayerEditorTest.FaceRelinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PESPlayerEditorTest"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Relink Face Id" Height="520" Width="620">
    <Grid Background="#FF212121">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="faceRelinkDataGrid"
                  Grid.Row="0"
                  Margin="8"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  MouseDoubleClick="FaceRelinkDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding FaceId}" Width="50"/>
                <DataGridTextColumn Header="Face" Binding="{Binding FaceName}" Width="220"/>
                <DataGridTextColumn Header="Assigned Players" Binding="{Binding AssignedPlayers}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,8">
            <Button x:Name="selectButton" Content="Select" Width="90" Margin="0,0,8,0" Click="SelectButton_Click"/>
            <Button x:Name="cancelButton" Content="Cancel" Width="90" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>